ADMIN_TOKEN=replace-with-a-long-random-value
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=https://nettodeals.ch

# Optional affiliate sources
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
TRADEDOUBLER_PRODUCTS_TOKEN=
TRADEDOUBLER_VOUCHERS_TOKEN=

# Automatic import and free Swiss trend signal
AUTO_SYNC_ENABLED=true
AUTO_SYNC_ON_START=true
AUTO_SYNC_INTERVAL=21600
GOOGLE_TRENDS_ENABLED=true
GOOGLE_TRENDS_URL=https://trends.google.com/trending/rss?geo=CH

# Optional editorial enrichment (official YouTube Data API)
YOUTUBE_API_KEY=
# Optionaler Groq-Pilot: Schlüssel nur serverseitig setzen, niemals committen.
GROQ_API_KEY=
# Optional; ohne Eintrag wird dieses Modell verwendet.
GROQ_MODEL=openai/gpt-oss-20b
DEAL_LIFETIME_HOURS=48

# Optionaler Gemini-Pilot: Free-Tier-Projekt ohne aktiviertes Billing verwenden.
GEMINI_API_KEY=
# Optional; Standard benötigt keinen weiteren ENV-Eintrag.
GEMINI_MODEL=gemini-2.5-flash-lite
